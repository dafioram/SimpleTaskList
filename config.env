# ==========================================
# PROJECT IDENTITY
# ==========================================
APP_NAME="Task List"
DESCRIPTION="Track Tasks and Their Status"
PYTHON_BIN="python3"

# ==========================================
# DIRECTORY STRUCTURE
# ==========================================
# Use "app" or "src" if your code is nested.
# Use "." if your main.py and requirements.txt are in the root.
APP_DIR="."

# ==========================================
# RUNNER CONFIGURATION (Select One)
# ==========================================

# --- OPTION 1: Standard Python Script (Flask dev server; fine for testing) ---
# ENTRYPOINT="python"
# ARGS="${INSTALL_DIR}/${APP_DIR}/run.py"

# --- OPTION 2: Uvicorn (FastAPI) ---
# ENTRYPOINT="uvicorn"
# ARGS="main:app --app-dir ${INSTALL_DIR}/${APP_DIR} --host 0.0.0.0 --port $PORT"

# --- OPTION 3: Gunicorn (WSGI) --- same settings as Docker and run.sh
# gunicorn.conf.py sets the app (main:app), working directory and 1 worker x 4
# threads. --bind here just follows your template's $PORT.
ENTRYPOINT="gunicorn"
ARGS="-c ${INSTALL_DIR}/${APP_DIR}/gunicorn.conf.py --bind 0.0.0.0:$PORT"

# ==========================================
# ENV VARS (Static)
# ==========================================
export PYTHONUNBUFFERED=1
# Optional tuning (defaults shown):
# export WEB_WORKERS=1        # gunicorn processes; keep at 1 on a Pi
# export WEB_THREADS=4        # threads per process
# export ACCESS_LOG=0         # 1 = log every request
# export API_BACKUP_KEY=...   # enables POST /api/backup
