# Copy to .env and edit. Used by docker-compose and run.sh.
PORT=5000

# Time zone for due/done dates in Docker (systemd and Windows use the machine's own).
TZ=America/New_York

# Key for POST /api/backup (send it in the X-Backup-Key header). Each call
# writes data/backups/tasks_backup_<timestamp>.db and deletes the previous one.
# Leave it starting with CHANGE_ME to keep the endpoint disabled.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_BACKUP_KEY=CHANGE_ME
